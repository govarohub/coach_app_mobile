<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CK-012.6: Permiso para obtener la ubicación precisa del usuario. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- CK-012.6: Permiso para obtener ubicación aproximada. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- CK-012.6:
         La funcionalidad de ubicación NO debe impedir la instalación
         en dispositivos que no dispongan de hardware de ubicación.
         La aplicación debe comprobar la disponibilidad de ubicación
         en tiempo de ejecución.
    -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- CK-012.6:
         El GPS tampoco es obligatorio para instalar la aplicación.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="coach_app_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Especifica el tema de Android que se aplica mientras
                 Flutter inicializa la interfaz de usuario. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Actividad principal de la aplicación. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- No eliminar.
             Utilizado por Flutter para registrar los plugins. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- Permite consultar actividades que pueden procesar texto.
         Utilizado por Flutter ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>