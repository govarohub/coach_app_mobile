rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsCompletedReservation(reservationId, coachId) {
      let reservationPath = /databases/$(database)/documents/reservations/$(reservationId);
      return isSignedIn()
        && exists(reservationPath)
        && get(reservationPath).data.status == 'completed'
        && get(reservationPath).data.clientId == request.auth.uid
        && get(reservationPath).data.coachId == coachId
        && request.auth.uid != coachId;
    }

    function hasValidReviewFields() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'reservationId',
          'coachId',
          'rating',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'reservationId',
          'coachId',
          'rating',
          'comment',
          'createdAt',
          'updatedAt'
        ])
        && data.reservationId is string
        && data.coachId is string
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && (!data.keys().hasAny(['comment'])
          || (data.comment is string && data.comment.size() <= 500));
    }

    match /reviews/{reservationId} {
      allow get, list: if true;

      allow create: if hasValidReviewFields()
        && request.resource.data.reservationId == reservationId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ownsCompletedReservation(
          reservationId,
          request.resource.data.coachId
        );

      allow update: if hasValidReviewFields()
        && request.resource.data.reservationId == resource.data.reservationId
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating',
          'comment',
          'updatedAt',
          'clientId'
        ])
        && ownsCompletedReservation(
          reservationId,
          resource.data.coachId
        );

      allow delete: if false;
    }

    // Preserve the existing authenticated access policy for other collections.
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn() && collection != 'reviews';
    }
  }
}